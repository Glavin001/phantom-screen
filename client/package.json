{
  "name": "@phantom-screen/web-client",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/npm/index.cjs",
  "module": "./dist/npm/index.js",
  "types": "./dist/npm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/npm/index.d.ts",
      "import": "./dist/npm/index.js",
      "require": "./dist/npm/index.cjs"
    },
    "./html-bundle": "./dist/html/phantom-screen-client.iife.js"
  },
  "files": [
    "dist/npm",
    "dist/html",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist *.tgz",
    "dev": "vite --config vite.app.config.ts",
    "build:app": "vite build --config vite.app.config.ts",
    "build:package": "vite build --config vite.package.config.ts && vite build --config vite.html.config.ts && tsc -p tsconfig.package.json",
    "build": "npm run clean && npm run build:package && npm run build:app",
    "preview": "vite preview --config vite.app.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "pack:tarball": "mkdir -p dist/artifacts && npm pack --json --pack-destination dist/artifacts"
  },
  "devDependencies": {
    "jsdom": "^28.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
